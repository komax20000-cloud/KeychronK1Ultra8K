#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keychron.h>

// [1] Enable with CONFIG_ZMK_KEY_REPEAT=y (already set in this shield's .conf).
//     Repeat is off by default; Fn+Up enables it, Fn+Down disables it, and Fn+Enter pauses it for 5 seconds.
//     Pressing Fn+Enter again during the pause restarts the 5-second countdown.
//     Bind repeatable keys normally, e.g. &kp A or &kp BACKSPACE; they repeat while enabled.
//     Fn+Z/X/C sets the first-repeat delay to 10/20/50 ms; default is 20 ms.
//     Repeat interval defaults to 30 ms (10-100 ms, in 5 ms steps).
//     &repeat_rate 0 decreases the interval (faster); &repeat_rate 1 increases it (slower).
//     Fn+Left/Right adjusts the interval.
//     Both timings reset to their defaults after reboot.
//     Modifiers, lock keys, and non-keyboard HID usages do not repeat.

// FUCK YOU

/ {
    behaviors {
        repeat_rate: repeat_rate {
            compatible = "zmk,behavior-key-repeat-rate";
            #binding-cells = <1>;
        };
        repeat_toggle: repeat_toggle {
            compatible = "zmk,behavior-key-repeat-toggle";
            #binding-cells = <1>;
        };
        repeat_delay: repeat_delay {
            compatible = "zmk,behavior-key-repeat-delay";
            #binding-cells = <1>;
        };
        repeat_pause: repeat_pause {
            compatible = "zmk,behavior-key-repeat-pause";
            #binding-cells = <0>;
        };
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
            tap-ms =<20>;
        };
        mouse_encoder: mouse_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;
            tap-ms =<20>;
        };
    };
    macro1:zm_ma{
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings=<&kp 0x770000>;
    };

    // mac_lock:mac_lock{
    //     compatible = "zmk,behavior-macro";
    //     #binding-cells = <0>;
    //     bindings
    //         = <&macro_tap_time 200>,
    //           < &kp C_AL_LOCK>
          
    //         ;
    //  };

    // encoder_any: encoder_any {
    //     compatible = "zmk,behavior-sensor-rotate-var";
    //     #sensor-binding-cells = <2>;
    //     bindings = <&kp>, <&kp>;
    //     tap-ms =<20>;
    // };

    lm: layer_mod {
        compatible = "zmk,behavior-macro-two-param";
        wait-ms = <0>;
        tap-ms = <0>;
        #binding-cells = <2>;
        bindings
            = <&macro_param_1to1>
            , <&macro_press &mo 0>
            , <&macro_param_2to1>
            , <&macro_press &kp 0>
            , <&macro_pause_for_release>
            , <&macro_param_2to1>
            , <&macro_release &kp 0>
            , <&macro_param_1to1>
            , <&macro_release &mo 0>
            ;
    };
    // td1:tapd_layer{
    //     compatible = "zmk,behavior-tap-dance1";
    //     #binding-cells = <1>;
    //     tapping-term-ms = <350>;
    //     bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    // };

    kc_lp:l1{
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&kc>,<&none>;
    };

    long_press_bootloader:lp_bootloader{
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bootloader>, <&none>;
    };
    // kc_nkro:kc_nkro{
    //     compatible = "zmk,behavior-hold-tap";
    //     #binding-cells = <2>;
    //     flavor = "tap-preferred";
    //     tapping-term-ms = <2000>;  // delay amount in ms
    //     bindings = <&kc NKRO>, <&none>;
    // };
    // Custom key slots: place &custom_key_1 / &custom_key_2 in any layer.
    // Edit only the bindings below to define what each key does, e.g.
    //   bindings = <&kp LC(C)>;                      // single key / shortcut
    //   bindings = <&kp H &kp I>;                    // key sequence
    //   bindings = <&kc BATINFO>;                    // Keychron function
    // They are unassigned (&none) until changed.
    ZMK_MACRO(custom_key_1, bindings = <&none>;)
    ZMK_MACRO(custom_key_2, bindings = <&none>;)
    ZMK_MACRO(bt_pair0, bindings = <&kc BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&kc BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&kc BT_PAIR 2>;)
    ZMK_MACRO(ppt_pair, bindings = <&kc PPT_PAIR 0>;)
    ZMK_MACRO(bt_recon_0, bindings = <&kc BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&kc BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&kc BT_SEL 2>;)
    ZMK_MACRO(ppt_recon, bindings = <&kc PPT_SEL 0>;)
    


    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
  
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
 
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    ppt_pair_0: ppt_pair_0 {
        compatible = "zmk,behavior-hold-tap";

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&ppt_pair>, <&ppt_recon>;
    };
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        #binding-cells =<1>;
    };
    combos {
        compatible = "zmk,combos";
        combo_a {
                timeout-ms = <1000>;
                layers =< 0 1>;
                key-positions = <58 65>; //fn+j+z
                bindings = <&kc_lp RCV>;
        };
        // combo_b {v
        //         timeout-ms = <1000>;
        //         layers =< 0 1>;
        //         key-positions = <64>; //fn+b
        //         bindings = <&kc BATINFO>;
        // };
        // combo_c {
        //         timeout-ms = <1000>;
        //         layers =< 0 1>;
        //         key-positions = <58 81>; //fn+home+right
        //         bindings = <&kc_lp RGBTEST>;
        // };
        // combo_win_l {
        //     timeout-ms = <500>;
        //     layers =<1>;
        //     //slow-release = <true>;
        //     key-positions = <89>; //fn+win
        //     bindings = <&long_press_fn_win 0 0>;
        // };
    };

    ZMK_MACRO(fn_win_l, bindings = <&kc FN_WIN 0>;)
    ZMK_MACRO(fn_win_s, bindings = <&kc FN_WIN 1>;)
    long_press_fn_win:l4{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_fn_win";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;   
        bindings = <&fn_win_l>, <&fn_win_s>;
    };
    ZMK_MACRO(fn_win, bindings = <&kc MO_WIN_LAYER>;)
    lp_mo_win:lp_mo_win{
        compatible = "zmk,behavior-hold-tap";

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;   
        bindings = <&fn_win>,<&trans>;
    };
    keymap {
        compatible = "zmk,keymap";       
        // Windows
        layer_zero {
        bindings = <
        &kp ESC     &kp F1                 &kp F2                   &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9       &kp F10    &kp F11              &kp F12             &kp C_MUTE            &kp PSCRN             &uc LG(H)        &rgb_ug RGB_EFF                  
        &kp GRAVE   &kp N1                 &kp N2                   &kp N3                              &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9       &kp N0     &kp MINUS            &kp EQUAL           &kp BSPC              &kp INSERT            &kp HOME         &kp PGUP                
        &kp TAB     &kp Q                  &kp W                    &kp E                               &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O        &kp P      &kp LBKT             &kp RBKT            &kp BSLH              &kp DEL               &kp END          &kp PGDN                
        &kp CLCK    &kp A                  &kp S                    &kp D                               &kp F                   &kp G               &kp H           &kp J           &kp K               &kp L        &kp SEMI   &kp SQT                                  &kp RET                                                                     
        &kp LSHFT                          &kp Z                    &kp X                               &kp C                   &kp V               &kp B           &kp N           &kp M               &kp COMMA    &kp DOT    &kp FSLH                                 &kp RSHFT                                   &kp UP                     
        &kp LCTRL   &kp LGUI               &kp LALT                                                                                                 &kp SPACE                                                        &kp RALT   &kp RGUI             &mo 1               &kp RCTRL             &kp LEFT              &kp DOWN          &kp RIGHT
        //keychron control
        &none   &kc SEL_PPT   &kc SEL_BLE       &kc SEL_USB   &kc  BATCHG
        >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        // Windows Fn layer
        layer_one {
        bindings = < 
                                        //f1                        //f2                        //f3                                //f4                        //f5            //f6                //f7            //f8                //f9        //f10           //f11                         //f12                     
        &trans                          &kp C_BRIGHTNESS_DEC        &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc LG(E)               &rgb_ug RGB_BRD     &rgb_ug RGB_BRI     &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &rgb_ug RGB_TOG      &trans                &trans    &rgb_ug RGB_TOG                              
        &trans                          &bt_pair_0 0 0              &bt_pair_1 0 0              &bt_pair_2 0 0                      &ppt_pair_0 0 0         &trans              &trans              &trans          &trans              &trans      &trans      &trans                      &trans               &trans               &trans                &trans    &trans 
        &rgb_ug RGB_TOG                 &rgb_ug RGB_EFF             &rgb_ug RGB_BRI             &rgb_ug RGB_HUI                     &rgb_ug RGB_SAI         &rgb_ug RGB_SPI     &trans              &trans          &trans              &trans      &trans      &trans                      &trans               &trans               &trans                &trans    &trans  
        &trans                          &rgb_ug RGB_EFR             &rgb_ug RGB_BRD             &rgb_ug RGB_HUD                     &rgb_ug RGB_SAD         &rgb_ug RGB_SPD     &trans              &trans          &trans              &trans      &trans      &trans                                           &repeat_pause
        &trans                          &repeat_delay 10            &repeat_delay 20                &repeat_delay 50    &trans              &kc BATINFO         &trans          &trans              &trans      &trans      &trans                                           &trans                                     &repeat_toggle 1
        &trans                          &trans                      &trans                          &trans              &trans              &trans              &trans              &trans              &repeat_rate 0         &repeat_toggle 0    &repeat_rate 1
        //
        &none                         &trans   &trans                      &trans                      &trans                                               
        >;
        sensor-bindings = <&rgb_encoder>;
        };

        
    };
};
&mt {
    tapping-term-ms = <400>;
};
&inc_dec_kp {
    tap-ms=<20>;
};